# ==============================================================================
# Monorepo Environment Example
# Copy to .env for local development. Never commit real production secrets.
# ==============================================================================

# Runtime
NODE_ENV="development"
PORT="3001"
# Optional overrides: LOG_LEVEL="debug|info|warn|error|silent", LOG_FORMAT="pretty|json"
# LOG_LEVEL="info"
# LOG_FORMAT="pretty"

# Database (packages/db & apps/api & apps/worker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starter_db"
DATABASE_SSL="false"
DB_MAX_CONNECTIONS="10"
# Set ALLOW_SEED="true" only when intentionally seeding in production
ALLOW_SEED="false"
# Optional Docker Compose Postgres overrides (defaults match docker-compose.yml)
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="postgres"
# POSTGRES_DB="starter_db"

# Better Auth & Security (apps/api)
# In production, generate a high-entropy 32+ char secret (never reuse dev default)
BETTER_AUTH_SECRET="default_development_secret_key_32_characters_minimum"
BETTER_AUTH_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000"
TRUSTED_PROXY_CIDRS=""

# Optional Google OAuth (both ID and secret must be set together)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Web App URLs & Feature Flags (apps/web)
INTERNAL_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Keep NEXT_PUBLIC_API_URL empty or set to public API origin when not using /api/* rewrites
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_STORAGE_ORIGIN=""

# Redis & BullMQ (apps/api & apps/worker)
REDIS_URL="redis://localhost:6379"
REDIS_PREFIX="starter"

# Object Storage / S3 / R2 / MinIO (apps/api)
# Configure S3_ACCESS_KEY_ID & S3_SECRET_ACCESS_KEY (e.g., from local MinIO) for direct presigned uploads
S3_BUCKET="starter-uploads"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
# Optional Docker Compose MinIO overrides (defaults match docker-compose.yml)
# MINIO_ROOT_USER="minioadmin"
# MINIO_ROOT_PASSWORD="minioadmin"

# Worker Email & Web Push Delivery (apps/worker)
RESEND_API_KEY=""
EMAIL_FROM="e2e-ai-starter <noreply@example.com>"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
WORKER_CONCURRENCY="5"
WORKER_HEALTH_HOST="0.0.0.0"
WORKER_HEALTH_PORT="3002"

# --- Mastra AI (multi-provider & pgvector) ---
# Chat model in Mastra "provider/model" format. Supported out of the box:
#   google/gemini-2.5-flash            -> GOOGLE_GENERATIVE_AI_API_KEY (or GOOGLE_API_KEY)
#   openai/gpt-5-mini                  -> OPENAI_API_KEY
#   anthropic/claude-sonnet-4-5        -> ANTHROPIC_API_KEY
#   openrouter/anthropic/claude-sonnet-4.5 -> OPENROUTER_API_KEY
# Only the key for the provider(s) you use is required.
MASTRA_DEFAULT_MODEL="google/gemini-2.5-flash"
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
# Semantic recall embeddings (independent of the chat provider): google/* or openai/* only.
#   google/gemini-embedding-001 | openai/text-embedding-3-small | openai/text-embedding-3-large
# Dimensions must be <= 2000 (pgvector HNSW limit). Changing the embedding model or
# dimensions after vectors exist requires dropping/re-indexing the Mastra vector tables.
# Semantic recall is disabled automatically when the embedding provider key is missing.
MASTRA_EMBEDDING_MODEL="google/gemini-embedding-001"
MASTRA_EMBEDDING_DIMENSIONS=768
MASTRA_DB_SCHEMA="mastra"
