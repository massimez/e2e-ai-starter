{
  "name": "e2e-ai-starter",
  "private": true,
  "description": "Production-ready multi-tenant SaaS starter with Next.js 16, Hono, Better Auth, Drizzle ORM, Mastra AI agents, pgvector, S3 storage, and BullMQ background workers",
  "keywords": [
    "nextjs",
    "nextjs-16",
    "react-19",
    "hono",
    "bun",
    "turborepo",
    "mastra",
    "ai-agents",
    "gemini",
    "openai",
    "anthropic",
    "openrouter",
    "better-auth",
    "drizzle-orm",
    "postgresql",
    "pgvector",
    "bullmq",
    "redis",
    "multi-tenant",
    "rbac",
    "tailwind-css",
    "s3",
    "r2",
    "typescript",
    "starter-kit",
    "boilerplate",
    "saas-template"
  ],
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "check": "ultracite check",
    "check-types": "turbo check-types",
    "db:generate": "turbo -F @workspace/db db:generate",
    "db:migrate": "turbo -F @workspace/db db:migrate",
    "db:push": "turbo -F @workspace/db db:push",
    "db:reset": "bun run db:migrate && bun run db:seed",
    "db:seed": "turbo -F @workspace/db db:seed",
    "db:studio": "turbo -F @workspace/db db:studio",
    "dev": "turbo dev",
    "dev:ai": "turbo -F @workspace/ai-core studio",
    "dev:api": "turbo -F @workspace/api dev",
    "dev:web": "turbo -F @workspace/web dev",
    "dev:worker": "turbo -F @workspace/worker dev",
    "fix": "ultracite fix",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then lefthook install; fi",
    "setup": "bun run scripts/setup.ts",
    "test": "NODE_ENV=test bun test"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "turbo": "2.11.11",
    "ultracite": "8.2.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.6",
    "@next/bundle-analyzer": "16.4.6",
    "zod": "4.6.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "next-themes": "0.4.6",
    "lucide-react": "1.72.0",
    "sonner": "2.0.8",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "5.107.1",
    "better-auth": "1.7.22",
    "hono": "4.13.18",
    "typescript": "7.0.2",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@biomejs/biome": "2.6.7",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1",
    "@aws-sdk/client-s3": "3.1168.0",
    "@aws-sdk/s3-request-presigner": "3.1168.0",
    "bullmq": "6.7.6",
    "ioredis": "6.0.0",
    "@mastra/core": "1.83.0",
    "@mastra/pg": "1.36.0",
    "@mastra/memory": "1.41.1",
    "@mastra/observability": "1.24.0",
    "@mastra/ai-sdk": "1.12.0",
    "ai": "7.0.172",
    "@ai-sdk/react": "4.0.176"
  }
}
