# Multi-stage Bun Dockerfile for Hono API
FROM oven/bun:1.4-alpine AS base
WORKDIR /app

FROM base AS pruner
COPY . .
RUN bun x turbo prune @workspace/api --docker

FROM base AS installer
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/bunfig.toml ./
RUN bun install --frozen-lockfile --production --ignore-scripts
COPY --from=pruner /app/out/full/ ./

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3001
WORKDIR /app

COPY --from=installer --chown=bun:bun /app ./

USER bun
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD bun -e "fetch('http://127.0.0.1:' + (process.env.PORT || '3001') + '/api/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["bun", "run", "apps/api/src/index.ts"]
