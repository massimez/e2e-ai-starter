# Multi-stage Bun Dockerfile for BullMQ Worker
FROM oven/bun:1.4-alpine AS base
WORKDIR /app

FROM base AS pruner
COPY . .
RUN bun x turbo prune @workspace/worker --docker

FROM base AS builder
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/bunfig.toml ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY --from=pruner /app/out/full/ ./
RUN bun build --target=bun apps/worker/src/index.ts --outfile /app/dist/worker.js

FROM base AS runner
ENV NODE_ENV=production
ENV WORKER_HEALTH_PORT=3002
WORKDIR /app

COPY --from=builder --chown=bun:bun /app/dist/worker.js ./worker.js

USER bun
EXPOSE 3002
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD bun -e "fetch('http://127.0.0.1:' + (process.env.WORKER_HEALTH_PORT || '3002') + '/healthz').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["bun", "run", "./worker.js"]
